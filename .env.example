NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=troque-por-uma-chave-segura-com-pelo-menos-32-caracteres
# Mantido temporariamente apenas para migrar refresh tokens JWT antigos.
REFRESH_SECRET=troque-por-outra-chave-segura-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=30m
REFRESH_SESSION_TTL_DAYS=30
REFRESH_COOKIE_NAME=bruna_refresh
LEGACY_REFRESH_MIGRATION_ENABLED=true
CORS_ORIGINS=https://bruna-affonso-frontend.pages.dev,http://localhost:5173
REQUEST_BODY_LIMIT=6mb
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
